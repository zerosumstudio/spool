{
	"name": "@zerosumstudio/spool",
	"version": "4.0.0",
	"description": "spool is a small CLI for building micro frontends",
	"keywords": [
		"micro-frontends",
		"module-federation",
		"vite",
		"react",
		"svelte",
		"vue",
		"cli",
		"scaffolding",
		"monorepo"
	],
	"homepage": "https://github.com/zerosumstudio/spool#readme",
	"bugs": {
		"url": "https://github.com/zerosumstudio/spool/issues"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/zerosumstudio/spool.git"
	},
	"license": "MIT",
	"author": "zerosum studio <hello@zerosum.studio>",
	"type": "module",
	"bin": {
		"spool": "./dist/index.js"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"build": "tsup",
		"dev": "tsup --watch",
		"format": "prettier --write . --ignore-path ../../.gitignore --ignore-path ../../.prettierignore",
		"format:check": "prettier --check . --ignore-path ../../.gitignore --ignore-path ../../.prettierignore",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"prepublishOnly": "node -e \"const f=require('fs');f.copyFileSync('../../README.md','README.md');f.copyFileSync('../../LICENSE','LICENSE')\" && pnpm run verify",
		"start": "node ./dist/index.js",
		"test": "vitest",
		"test:coverage": "vitest run --coverage",
		"test:e2e": "pnpm run build && playwright test -c e2e/playwright.config.ts",
		"test:integration": "pnpm run build && vitest run --config vitest.integration.config.ts",
		"test:run": "vitest run",
		"type-check": "tsc --noEmit && tsc --noEmit -p e2e",
		"verify": "pnpm run type-check && pnpm run lint && pnpm run format:check && pnpm run test:coverage && pnpm run build"
	},
	"dependencies": {
		"@clack/prompts": "^1.7.0",
		"commander": "^15.0.0",
		"cross-spawn": "^7.0.6",
		"picocolors": "^1.1.1",
		"prettier": "^3.9.6",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@playwright/test": "^1.64.1",
		"@types/cross-spawn": "^6.0.6",
		"@types/node": "^26.2.0",
		"@vitest/coverage-v8": "^4.1.10",
		"esbuild": "^0.28.2",
		"node-pty": "^1.1.0",
		"tsup": "^8.5.1",
		"typescript": "^7.0.2",
		"vitest": "^4.1.10"
	},
	"engines": {
		"node": ">=22.12.0"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	}
}
