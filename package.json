{
	"name": "spool-monorepo",
	"version": "1.0.0",
	"private": true,
	"description": "spool: toolset for micro frontends and modular frontend projects",
	"license": "MIT",
	"author": "zerosum studio <hello@zerosum.studio>",
	"type": "module",
	"scripts": {
		"build": "pnpm -r --filter \"./packages/*\" build",
		"dev": "pnpm --filter @zerosumstudio/spool dev",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"spool": "pnpm --filter @zerosumstudio/spool exec spool",
		"test": "pnpm -r --filter \"./packages/*\" test",
		"test:coverage": "pnpm -r --filter \"./packages/*\" test:coverage",
		"test:run": "pnpm -r --filter \"./packages/*\" test:run",
		"type-check": "pnpm -r --filter \"./packages/*\" type-check",
		"verify": "pnpm run type-check && pnpm run lint && pnpm run format:check && pnpm run test:coverage && pnpm run build"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"eslint": "^10.8.1",
		"globals": "^17.9.0",
		"prettier": "^3.9.6",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.66.0"
	},
	"packageManager": "pnpm@11.6.0",
	"engines": {
		"node": ">=22.12.0"
	}
}
