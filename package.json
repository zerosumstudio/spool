{
	"name": "spool-monorepo",
	"version": "1.0.0",
	"private": true,
	"description": "spool: toolset for micro frontends and modular frontend projects",
	"license": "MIT",
	"author": "zerosum studio <hello@zerosum.studio>",
	"type": "module",
	"scripts": {
		"build": "pnpm -r --filter \"./packages/*\" build",
		"dev": "pnpm --filter @zerosumstudio/spool dev",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"spool": "pnpm --filter @zerosumstudio/spool exec spool",
		"test": "pnpm -r --filter \"./packages/*\" test",
		"test:coverage": "pnpm -r --filter \"./packages/*\" test:coverage",
		"type-check": "pnpm -r --filter \"./packages/*\" type-check",
		"verify": "pnpm run type-check && pnpm run lint && pnpm run format:check && pnpm run test:coverage && pnpm run build"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"eslint": "^10.15.0",
		"globals": "^17.14.0",
		"prettier": "^3.10.1",
		"prettier-plugin-svelte": "^4.2.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.74.0"
	},
	"packageManager": "pnpm@11.6.0",
	"engines": {
		"node": ">=26"
	}
}
